<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#F2070A12"
                android:centerColor="#D90E1726"
                android:endColor="#B31E293B"
                android:type="linear" />
            <stroke android:width="2.5dp" android:color="@color/vw_accent_light" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#F2070A12"
                android:centerColor="#D90E1726"
                android:endColor="#801E293B"
                android:type="linear" />
            <stroke android:width="1dp" android:color="@color/vw_border_subtle" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
