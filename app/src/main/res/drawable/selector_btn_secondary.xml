<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vw_card_hover" />
            <stroke android:width="2dp" android:color="@color/vw_accent_light" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vw_card_hover" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vw_card" />
            <stroke android:width="1dp" android:color="@color/vw_border_subtle" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
