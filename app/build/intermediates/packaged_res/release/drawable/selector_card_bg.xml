<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface_card_selected" />
            <stroke android:width="3dp" android:color="@color/focus_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface_card_selected" />
            <stroke android:width="2dp" android:color="@color/accent_blue" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface_card" />
            <stroke android:width="1dp" android:color="@color/unfocused_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
