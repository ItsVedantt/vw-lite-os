<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:paddingStart="36dp"
    android:paddingEnd="36dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Brand Logo & Title -->
        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_launcher_vw"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="@string/app_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp"
                android:text="INDEPENDENT OS • V3" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Network Status Pill -->
        <LinearLayout
            android:id="@+id/pillNetwork"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_badge_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivHeaderNetIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_wifi"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvHeaderNetStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:text="Wi-Fi" />
        </LinearLayout>

        <!-- RAM Usage Monitor Pill (512 MB Budget) -->
        <LinearLayout
            android:id="@+id/pillRam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_badge_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_ram"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvHeaderRam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:text="RAM: -- / 512 MB" />
        </LinearLayout>

        <!-- Digital Clock & Date -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/tcClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format24Hour="hh:mm a"
                android:format12Hour="hh:mm a"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/tcDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format24Hour="EEE, MMM d"
                android:format12Hour="EEE, MMM d"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Navigation Tabs Bar -->
    <HorizontalScrollView
        android:id="@+id/navScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/navTabsLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabHome"
                style="@style/TvNavTab"
                android:text="@string/nav_home" />

            <TextView
                android:id="@+id/tabApps"
                style="@style/TvNavTab"
                android:layout_marginStart="8dp"
                android:text="@string/nav_apps" />

            <TextView
                android:id="@+id/tabStore"
                style="@style/TvNavTab"
                android:layout_marginStart="8dp"
                android:text="@string/nav_store" />

            <TextView
                android:id="@+id/tabLiveTv"
                style="@style/TvNavTab"
                android:layout_marginStart="8dp"
                android:text="@string/nav_live_tv" />

            <TextView
                android:id="@+id/tabHdmi"
                style="@style/TvNavTab"
                android:layout_marginStart="8dp"
                android:text="@string/nav_hdmi" />

            <TextView
                android:id="@+id/tabIptv"
                style="@style/TvNavTab"
                android:layout_marginStart="8dp"
                android:text="@string/nav_iptv" />

            <TextView
                android:id="@+id/tabNetwork"
                style="@style/TvNavTab"
                android:layout_marginStart="8dp"
                android:text="@string/nav_network" />

            <TextView
                android:id="@+id/tabSettings"
                style="@style/TvNavTab"
                android:layout_marginStart="8dp"
                android:text="@string/nav_settings" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Content Frame (Switches dynamically per Tab) -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp">

        <!-- =================== TAB 1: HOME =================== -->
        <ScrollView
            android:id="@+id/viewTabHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Featured App Hero Card -->
                <LinearLayout
                    android:id="@+id/cardHero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/bg_hero_card">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@drawable/ic_launcher_vw"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/accent_cyan"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:text="FEATURED APPLICATION" />

                        <TextView
                            android:id="@+id/tvHeroTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:text="VW App Store • Curated Market" />

                        <TextView
                            android:id="@+id/tvHeroSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:text="Discover verified lightweight apps, SmartTube, VLC, IPTV players, and utilities." />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnHeroLaunch"
                        style="@style/TvActionButton"
                        android:text="Explore Store" />
                </LinearLayout>

                <!-- Section: Favourite Apps -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="@string/section_favorites" />

                <TextView
                    android:id="@+id/tvEmptyFavorites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone"
                    android:text="@string/empty_favorites" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHomeFavorites"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <!-- Section: Recently Opened Apps -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="@string/section_recents" />

                <TextView
                    android:id="@+id/tvEmptyRecents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone"
                    android:text="@string/empty_recents" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHomeRecents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <!-- Section: IPTV Favourites -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="@string/section_iptv_favorites" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHomeIptvFavs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <!-- Section: Quick TV Inputs -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="@string/section_quick_inputs" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHomeInputs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </LinearLayout>
        </ScrollView>

        <!-- =================== TAB 2: APPS =================== -->
        <LinearLayout
            android:id="@+id/viewTabApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvAppsCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="Installed Applications" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:text="Long press any app to Pin to Favorites or View Details" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAllApps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- =================== TAB 3: STORE =================== -->
        <LinearLayout
            android:id="@+id/viewTabStore"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etStoreSearch"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/selector_card_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:hint="@string/store_search_hint"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btnStoreSearch"
                    style="@style/TvActionButton"
                    android:layout_marginStart="12dp"
                    android:text="Search" />

                <Button
                    android:id="@+id/btnStoreClearCache"
                    style="@style/TvActionButton"
                    android:layout_marginStart="12dp"
                    android:text="@string/btn_clear_cache" />
            </LinearLayout>

            <!-- Store Categories -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutStoreCategories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStoreApps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- =================== TAB 4/5: LIVE TV & HDMI =================== -->
        <LinearLayout
            android:id="@+id/viewTabInputs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="@string/inputs_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:text="Direct access to TV Tuner and HDMI 1 / 2 / 3 hardware inputs." />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvInputsTab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <!-- =================== TAB 6: IPTV =================== -->
        <LinearLayout
            android:id="@+id/viewTabIptv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etIptvSearch"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/selector_card_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:hint="@string/iptv_search_hint"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btnIptvRefresh"
                    style="@style/TvActionButton"
                    android:layout_marginStart="12dp"
                    android:text="@string/iptv_refresh" />
            </LinearLayout>

            <!-- IPTV Categories -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutIptvCategories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvIptvChannels"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- =================== TAB 7: NETWORK =================== -->
        <ScrollView
            android:id="@+id/viewTabNetwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="@string/network_title" />

                <!-- Network Status Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/selector_card_bg">

                    <TextView
                        android:id="@+id/tvNetTypeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_cyan"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:text="Connection: Wi-Fi" />

                    <TextView
                        android:id="@+id/tvNetDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"
                        android:text="IP: 192.168.1.x\nGateway: 192.168.1.1\nDNS: 8.8.8.8" />

                    <TextView
                        android:id="@+id/tvNetDiagnosticResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/accent_gold"
                        android:textSize="13sp"
                        android:text="Diagnostic: Ready to test" />
                </LinearLayout>

                <!-- Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnNetTest"
                        style="@style/TvActionButton"
                        android:text="@string/btn_test_connection" />

                    <Button
                        android:id="@+id/btnNetOpenWifi"
                        style="@style/TvActionButton"
                        android:layout_marginStart="14dp"
                        android:text="@string/btn_open_wifi_settings" />

                    <Button
                        android:id="@+id/btnNetOpenEthernet"
                        style="@style/TvActionButton"
                        android:layout_marginStart="14dp"
                        android:text="@string/btn_open_ethernet_settings" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- =================== TAB 8: SETTINGS =================== -->
        <ScrollView
            android:id="@+id/viewTabSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="@string/settings_title" />

                <!-- Hardware & Device Info Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/selector_card_bg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_cyan"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:text="@string/settings_hardware_info" />

                    <TextView
                        android:id="@+id/tvSettingsHardware"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"
                        android:text="Manufacturer: VW\nMotherboard: T.PSK518D.PB806\nCPU: ARM 4-Core\nGPU: Mali-G31 MP2\nRAM: 512 MB Budget\nAndroid: 9.0 (Pie, API 28)\nFirmware: 20260227_153820" />
                </LinearLayout>

                <!-- Actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSettingsCleanRam"
                        style="@style/TvActionButton"
                        android:text="@string/btn_clean_ram" />

                    <Button
                        android:id="@+id/btnSettingsOpenNative"
                        style="@style/TvActionButton"
                        android:layout_marginStart="14dp"
                        android:text="@string/settings_native_android" />

                    <Button
                        android:id="@+id/btnSettingsResetLauncher"
                        style="@style/TvActionButton"
                        android:layout_marginStart="14dp"
                        android:text="@string/btn_reset_launcher" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </FrameLayout>

</LinearLayout>
